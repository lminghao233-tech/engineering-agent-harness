ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}
WORKDIR /app
COPY requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock && useradd --uid 10001 --create-home harness
COPY harness ./harness
COPY data/manifest.json ./data/manifest.json
COPY data/agent-visible ./data/agent-visible
RUN mkdir /data && chown 10001:10001 /data
ENV HARNESS_DATA=/data PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8787
CMD ["python","-m","uvicorn","harness.api:app","--host","0.0.0.0","--port","8787","--limit-concurrency","64","--timeout-keep-alive","5"]
