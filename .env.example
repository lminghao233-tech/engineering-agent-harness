# Copy to .env, then source explicitly in your shell (or use deployment scripts).
HARNESS_DATA=./var
# Required for every API request. Use a random value of at least 32 characters.
HARNESS_API_TOKEN=
MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
MODEL_NAME=
MODEL_API_KEY=
# No calls are made unless this is explicitly true. Reserve worst-case token usage per call.
MODEL_CALLS_AUTHORIZED=false
MODEL_CONTEXT_TOKENS=16384
# Only an operator-prepared image with /opt/venv and required dependencies; digest required.
HARNESS_IMAGE=
HARNESS_CPU=2
HARNESS_MEMORY=2g
HARNESS_DISK_MB=256
HARNESS_TOTAL_DISK_MB=4096
HARNESS_TOOL_TIMEOUT=60
HARNESS_LEASE_SECONDS=90
